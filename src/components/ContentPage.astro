---
import OriginalLayout from '../layouts/Layout.astro';
import Demo2Layout from '../layouts/Demo2Layout.astro';
import { getDemoPages } from '../data/pages';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import SourceText from '../components/SourceText.astro';
import SourceDetails from '../components/SourceDetails.astro';
import records from '../data/content.json';
import {provider,resources,services,activities} from '../data/site';
interface Props { page: ReturnType<typeof getDemoPages>[number]; version?: 1 | 2; }
const {page,version=1}=Astro.props;
const Layout=version===2?Demo2Layout:OriginalLayout;
const url=(href:string)=>version===2&&href.startsWith('/')&&!href.startsWith('/documents/')?'/demo-2'+href:href;

const route=page.route;
const source=records.find(p=>p.route===route);
const home=records.find(p=>p.route==='/')!;
const work=records.find(p=>p.route==='/what-we-do/')!;
const isEvents=route.startsWith('/events/');
const isNews=route.startsWith('/news/')||/^\/\d{4}\/\d{2}\/$/.test(route);
const isReferral=page.kind==='referral';
const events=records.filter(p=>p.kind==='event');
const articles=records.filter(p=>p.kind==='article');
const friendlyTitle=page.title===page.title.toUpperCase()?page.title.toLowerCase().replace(/\b\w/g,(c:string)=>c.toUpperCase()):page.title;
const descriptions:Record<string,string>={
 '/donate/':'Your generosity helps keep frontline support, healthy relationship education and community activities moving forward.',
 '/join-us/':'A shared activity. A new challenge. A conversation with someone who understands. Find your way to be part of the PLF community.',
 '/get-support/':'Person-centred support for male victims and survivors of domestic abuse. A listening ear, practical advice and a way forward.',
 '/what-we-do/':'Support, education and connection. Explore the ways the foundation helps people and works towards healthier relationships.',
 '/activity-groups/':'Free community groups for men and women. No membership or regular commitment is required; find the activity that suits you.',
 '/our-story/':'A foundation built on friendship, created to honour Paul Lavelle and help others in his memory.',
 '/get-in-touch/':'Support, general enquiries and information about visiting our spaces. Start with the contact option that fits your needs.',
 '/resources/':'Policies, fundraising information and activity guidance, all in one place.',
 '/agency-referral/':'Speak to the team about the appropriate professional referral route.',
 '/referral-forms/':'Find the right starting point for a self-referral or a professional referral.',
 '/referral-forms/self-referral/':'Find out what to expect, then continue to the foundation’s existing self-referral service.',
};
const description=descriptions[route]||(isEvents?'Take a look back at the events and challenges that brought our community together.':isNews?'News, memories and moments from the PLF community.':'Learn more about the foundation’s work and community.');
function field(label:string){const match=page.body.match(new RegExp(label+':\\s*\\n([^\\n]+)'));return match?.[1]?.trim()||'';}
const date=field('Date')||field('Start')||page.when.split('@')[0].trim();
const time=field('Time')||(page.when.includes('@')?page.when.split('@').slice(1).join('@').trim():'See event information');
const venue=page.body.split(/VENUE\s*\n/i)[1]?.trim().split('\n')[0]||'See event information';
const cost=field('Cost')||'Not recorded in the archive';
const sourceRelated=page.links.filter(l=>l.href.startsWith('/')&&!['/','/events/','/get-in-touch/','/what-we-do/','/referral-forms/self-referral/','/privacy-policy/','/cookie-policy-uk/','/activity-groups/','/news/'].includes(l.href)&&!l.label.includes('Manage')&&!l.href.includes('#')).slice(0,8);
---
<Layout title={isEvents?'Events & challenges':isNews?'News & stories':friendlyTitle} description={description}>
<section class="page-hero"><div class="wrap"><div class="breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">/</span>{page.kind==='event'?<a href={url('/events/')}>Events</a>:<span>{isEvents?'Events':isNews?'News & stories':friendlyTitle}</span>}</div><p class="eyebrow">{page.kind==='event'?'Community archive':isReferral||route==='/get-support/'?'Support & referrals':route==='/donate/'?'Keep the work going':route==='/activity-groups/'||route==='/join-us/'?'Our community':'Paul Lavelle Foundation'}</p><h1>{isEvents?'Events & challenges':isNews?'News & stories':friendlyTitle}</h1>{page.kind!=='event'&&<p class="lead">{description}</p>}
{route==='/donate/'&&<a class="button" href={provider}>Continue to JustGiving <span aria-hidden="true">↗</span></a>}
{page.kind==='event'&&<><span class="status">{page.status==='past'?'Past event':'Archived event'}</span><dl class="event-facts"><div><dt>Date</dt><dd>{date||'See archived details'}</dd></div><div><dt>Time</dt><dd>{time}</dd></div><div><dt>Location</dt><dd>{venue}</dd></div><div><dt>Entry cost</dt><dd>{cost}</dd></div></dl></>}
</div></section>

{route==='/donate/'&&<>
<section class="section"><div class="wrap content-grid"><div><h2>A gift that keeps<br/>the work moving.</h2><p class="lead">Donations help the foundation continue its weekly frontline service, deliver relationship education and sustain community activities for physical and mental wellbeing.</p><div class="giving-reasons" style="--ink:#153f55"><div><span>01</span><p style="color:var(--ink)">Support for men affected by domestic abuse</p></div><div><span>02</span><p style="color:var(--ink)">Healthy relationship and anti-abuse workshops</p></div><div><span>03</span><p style="color:var(--ink)">Community activity groups and shared goals</p></div></div><div class="actions"><a class="button" href={provider}>Continue to JustGiving <span aria-hidden="true">↗</span></a></div><p class="source-note" style="margin-top:20px">You’ll leave this preview and go to the foundation’s existing JustGiving profile. Choose your gift and any available giving frequency there. Payment details and confirmation are handled by JustGiving.</p></div><aside class="side-panel"><h2>Thank you for being here.</h2><p>You can also help by taking part in an activity, fundraising with friends or sharing the foundation’s work.</p><a href="#fundraise">Fundraise in your own way ↓</a><a href={url('/join-us/')}>Find a way to join us ↗</a><Photo name="cycling" alt="PLF cycling club members together after a ride"/></aside></div></section>
<section class="section section-soft" id="fundraise"><div class="wrap intro-grid"><div><p class="eyebrow">Your idea. Our shared purpose.</p><h2>Make it your<br/>own challenge.</h2></div><div><p>Whether it’s a ride, a run or a fundraiser with friends, our fundraising pack is a useful place to start.</p><div class="actions"><a class="button button-outline" href={url('/documents/PLF-Fundraising-Pack.pdf')}>Read the fundraising pack <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:info@paullavellefoundation.co.uk">Talk to the team <Arrow/></a></div></div></div></section></>}

{route==='/join-us/'&&<section class="section"><div class="wrap"><div class="intro-grid"><div><p class="eyebrow">A community, not a membership</p><h2>Find something<br/>to share.</h2><p>Our activity groups are free, and open to both men and women. Join for the company, work towards a goal or try something that feels right for you.</p><a class="text-link" href={url('/activity-groups/')}>All activity information <Arrow/></a></div><Photo name="cycling" alt="PLF community cycling group with their bikes"/></div><div class="activity-grid" style="margin-top:60px">{activities.map(a=><a class="activity-item" href={url('/activity-groups/#'+a.id)}><div class="photo-frame"><Photo name={a.image} alt={a.alt}/></div><div class="activity-label"><h3>{a.name}</h3><Arrow/></div><p>{a.tag}</p></a>)}</div><div class="events-empty" style="margin-top:65px"><div><span class="status">Events & challenges</span><h3>Look back. Get inspired.</h3></div><div><p>There are no upcoming events in this content snapshot. Browse the archive and see what our community has done together.</p><a class="text-link" href={url('/events/')}>Explore events <Arrow/></a></div></div></div></section>}

{route==='/activity-groups/'&&<section class="section"><div class="wrap"><div class="notice"><p>Session times and locations below come from the published PLF information. Please contact the organisers to confirm the next session and current guidance before attending.</p></div>{activities.map(a=><article class="activity-detail" id={a.id}><Photo name={a.image} alt={a.alt}/><div><p class="eyebrow">{a.tag}</p><h2>{a.name}</h2><p>{a.description}</p><ul class="prose">{a.facts.map(f=><li>{f}</li>)}</ul><p class="muted">{a.published}</p><div class="actions"><a class="button button-outline" href={'mailto:info@paullavellefoundation.co.uk?subject='+encodeURIComponent('Joining the PLF '+a.name+' group')}>Ask about joining <Arrow/></a><a class="text-link" href={url(a.document.href)}>Activity guidance ↗</a></div></div></article>)}<SourceDetails page={source!} label="Full published activity information, guidance and history"/></div></section>}

{route==='/what-we-do/'&&<section class="section"><div class="wrap"><div class="intro-grid"><div><p class="eyebrow">Here to help</p><h2>A listening ear.<br/>A practical next step.</h2></div><div><p class="lead">Our male domestic abuse service blends therapeutic support, advocacy, advice and signposting. The approach is person-centred, with support shaped around each person’s needs.</p><a class="button button-outline" href={url('/get-support/')}>Find support <Arrow/></a></div></div><div class="archive-list">{services.map(s=><a class="archive-item" href={url(s.href)}><h3>{s.title}</h3><p style="display:block">{s.description}</p><span class="text-link" style="margin-top:15px">Find out more <Arrow/></span></a>)}</div><SourceDetails page={source!} label="Full service information and the support we offer"/></div></section>}

{(route==='/get-support/'||isReferral)&&<section class="section"><div class="wrap content-grid"><div class="prose">
{route==='/agency-referral/'?<><h2>Making a professional referral</h2><p>The agency-referral page was unavailable in the captured website. Please contact the foundation to confirm the current professional referral process.</p><p>No referral is submitted through this preview.</p><a class="button button-outline" href="mailto:info@paullavellefoundation.co.uk?subject=Professional%20referral%20enquiry">Contact the referral team <span aria-hidden="true">↗</span></a></>:route==='/referral-forms/self-referral/'?<><h2>What to expect</h2><p>The existing service uses a screening questionnaire to understand your circumstances, assess risk and identify whether PLF is the appropriate service for you.</p><p>The foundation describes its service as support for low to medium risk male victims of domestic abuse. The questionnaire includes consent, contact information and questions about safety and current needs.</p><p>This preview does not collect or store referral answers.</p><a class="button button-outline" href="https://paullavellefoundation.co.uk/referral-forms/self-referral/">Continue to the existing self-referral service <span aria-hidden="true">↗</span></a></>:<><h2>Support shaped around you.</h2><p>We offer a non-judgemental listening ear, emotional and practical support, advice and guidance for men who are experiencing or have experienced domestic abuse.</p><p>Support may include therapeutic sessions, advocacy, peer support, legal signposting and help with understanding the impact of abuse.</p><ul><li>Face-to-face appointments in a PLF hub</li><li>Virtual online appointments</li><li>Telephone appointments</li></ul><ul class="link-list"><li><a href={url('/referral-forms/self-referral/')}>I’m seeking support for myself <Arrow/></a></li><li><a href={url('/agency-referral/')}>I’m making a professional referral <Arrow/></a></li><li><a href={url('/lgbtq/')}>LGBTQ+ support <Arrow/></a></li><li><a href={url('/information-on-male-domestic-abuse/')}>Understanding domestic abuse <Arrow/></a></li></ul></>}
<hr class="divider"/><h2>Speak to the team</h2><a class="contact-number" href="tel:01516513777">0151 651 3777</a><p>This is a support line, not a crisis line. Published office and telephone hours are Monday–Thursday, 9am–5pm. If the team cannot answer, you can leave a message.</p><a href={url('/get-in-touch/')}>More contact information ↗</a>
{source&&route!=='/agency-referral/'&&<SourceDetails page={source} label="Published referral information and screening requirements"/>}
{!source&&<SourceDetails page={work} label="Full published information about support services"/>}
</div><aside class="side-panel"><h2>Leaving this website</h2><p>Quick Exit takes you to Google UK. It does not clear your browser history.</p><a href="https://www.google.co.uk/">Quick Exit ↗</a><h2 style="margin-top:36px">If you’re in immediate danger</h2><p>The existing referral guidance says to call 999 in an emergency.</p><a href="tel:999">Call 999</a><a href={url('/resources/')}>Safeguarding & resources ↗</a></aside></div></section>}

{isEvents&&<section class="section"><div class="wrap"><div class="events-empty"><div><span class="status">Upcoming events</span><h2 class="small-heading">Nothing announced<br/>in this preview.</h2></div><div><p>The supplied event listing had no upcoming events on 8 October 2026. Our community activities offer another way to get involved.</p><a class="text-link" href={url('/activity-groups/')}>Explore our activity groups <Arrow/></a></div></div><div id="past-events" style="padding-top:65px"><p class="eyebrow">Our community in action</p><h2>Past events & challenges</h2><div class="search-field"><label for="event-search">Find an event in the archive</label><input id="event-search" type="search" placeholder="Search by event name" data-archive-search/></div><p class="search-status" aria-live="polite" data-search-status>{events.length} archived events</p><div class="archive-list" data-archive-list>{events.map(e=><a class="archive-item" href={url(e.route)} data-search-text={e.title.toLowerCase()}><span class="status">{e.status==='past'?'Past event':'Archive'}</span><h3>{e.title===e.title.toUpperCase()?e.title.toLowerCase().replace(/\b\w/g,c=>c.toUpperCase()):e.title}</h3><p><span>{e.when||'View archived details'}</span><Arrow/></p></a>)}</div><p class="no-results" hidden data-no-results>No matching events. Try another event name.</p></div>{source&&<SourceDetails page={source} label="Original event listing information"/>}</div></section>}

{page.kind==='event'&&<section class="section"><div class="wrap content-grid"><div class="prose"><div class="notice"><p>This is an archived event. Booking is closed in this preview. Original dates and information are retained below.</p></div><SourceText paragraphs={page.paragraphs.filter(p=>!/^« All Events$/.test(p)&&p!=='This event has passed.')}/><a class="text-link" href={url('/events/')}>Back to all events <Arrow/></a></div><aside>{page.images.filter(i=>!i.toLowerCase().includes('partner')).map((image:string)=><figure class="event-poster" style="margin-bottom:30px"><Photo name={image} alt={'Original poster or programme for '+friendlyTitle} sizes="(max-width: 760px) 100vw, 35vw"/><figcaption>Original event material</figcaption></figure>)}<div class="side-panel"><h2>Find your next connection</h2><p>Our community groups offer another way to be part of PLF.</p><a href={url('/activity-groups/')}>Community activities ↗</a><a href={url('/events/')}>Events archive ↗</a></div></aside></div></section>}

{route==='/our-story/'&&<section class="section"><div class="wrap"><div class="story-grid"><figure class="story-photo"><Photo name="paul" alt="Paul Lavelle, remembered by his family and friends"/><figcaption>Paul Lavelle</figcaption></figure><div class="story-copy"><p class="eyebrow">A legacy of friendship</p><h2>It started with Paul.<br/>It continues with us.</h2><p>Paul Lavelle was killed in a domestic abuse incident in May 2017. His family and friends came together to raise awareness of domestic abuse towards men and honour his memory.</p><p>The charity was registered in April 2018. It developed from awareness-raising through sport into specialist support, healthy relationship education and community activity groups.</p><p>After opening an office in 2019, the foundation began delivering its education and activity programmes in 2020 and opened its dedicated frontline service on 15 July that year.</p><a class="text-link" href={url('/what-we-do/')}>See the work Paul inspired <Arrow/></a></div></div><SourceDetails page={home} label="The foundation’s full published history and aims"/><h2 style="margin-top:65px">Stories from the community</h2><div class="archive-list">{articles.slice(0,6).map(a=><a class="archive-item" href={url(a.route)}><h3>{a.title}</h3><p><span>{a.route.split('/').slice(1,4).reverse().join('/')}</span><Arrow/></p></a>)}</div><a class="text-link" href={url('/news/')} style="margin-top:30px">All news & stories <Arrow/></a></div></section>}

{isNews&&<section class="section"><div class="wrap"><div class="archive-list">{articles.filter(a=>!/^\/\d{4}\/\d{2}\/$/.test(route)||a.route.startsWith(route)).map(a=><a class="archive-item" href={url(a.route)}><h3>{a.title}</h3><p><span>{a.route.split('/').slice(1,4).reverse().join('/')}</span><Arrow/></p></a>)}</div><p style="margin-top:35px"><a href={url('/news/')}>View the full news archive</a></p>{source&&<SourceDetails page={source} label="Original archive information"/>}</div></section>}

{route==='/get-in-touch/'&&<section class="section"><div class="wrap"><div class="contact-panels"><div><p class="eyebrow">Support enquiries</p><h2>A listening ear.</h2><a class="contact-number" href="tel:01516513777">0151 651 3777</a><p>The support line is not a crisis line. If you’re seeking support for domestic abuse, the self-referral route is another way to start.</p><a class="text-link" href={url('/referral-forms/self-referral/')}>Self-referral information <Arrow/></a></div><div><p class="eyebrow">General / office enquiries</p><h2>Talk to the team.</h2><a class="contact-number" href="tel:01512944176">0151 294 4176</a><a class="contact-email" href="mailto:info@paullavellefoundation.co.uk">info@paullavellefoundation.co.uk</a><p style="margin-top:25px">For activities, fundraising, education workshops and general questions.</p></div><div><h2>Opening hours</h2><p>Published office and telephone hours: Monday–Thursday, 9am–5pm.</p><p>PLF is a small part-time team. If you cannot get through, leave a message; the published information says voicemail is monitored regularly.</p><p>The published referral inbox response target is within 48 hours.</p><p class="source-note">Information captured 8 October 2026; confirm current arrangements with the team.</p></div><div><h2>Visiting our spaces</h2><p>The foundation has information about Wirral and Liverpool spaces. Appointments are required, and address references differ across the source documents.</p><p>Please contact the team to confirm the correct location and appointment before travelling.</p><a class="text-link" href={url('/spaces/')}>Explore our spaces <Arrow/></a></div></div><details class="source-details"><summary>Further published contact information</summary><div class="prose"><p>Published general contact address: Devonshire Resource Centre, 141 Park Road North, Birkenhead, Wirral, CH41 0DD. Different addresses appear in other documents; confirm the intended location before visiting.</p><p>The published contact information says telephone calls are recorded for training and monitoring purposes.</p><p>Additional crisis-support contacts in the source: Cheshire & Wirral Partnership Crisis Team, 0800 145 6485; Samaritans, 116 123. These are external services, separate from the PLF support line.</p></div></details>{source&&<SourceDetails page={source} label="Full original contact page information"/>}</div></section>}

{(route==='/resources/'||route==='/disclaimer/')&&<section class="section"><div class="wrap content-grid"><div><h2>Documents & guidance</h2><p>Read the existing documents in their original form. For the latest version or activity arrangements, contact the foundation.</p>{resources.map(r=><article class="resource-item"><h3>{r.title}</h3><p>{r.description}</p><a class="text-link" href={url(r.href)}>Read document <span class="muted">{r.format}</span><span aria-hidden="true">↗</span></a></article>)}</div><aside class="side-panel"><h2>Information pages</h2><a href={url('/privacy-policy/')}>Privacy policy ↗</a><a href={url('/cookie-policy-uk/')}>Cookie policy ↗</a><a href={url('/information-on-male-domestic-abuse/')}>Male domestic abuse information ↗</a><a href={url('/get-in-touch/')}>Contact the foundation ↗</a><div id="preview" style="margin-top:45px"><h2>About this preview</h2><p>A frontend demonstration of a possible PLF redesign. Content comes from the website snapshot captured on 8 October 2026.</p><p>Original photographs and historic information are preserved. Payments, bookings and support referrals are handled by existing external services.</p><p>Published policy versions, activity guidance and addresses need charity review before a live release.</p></div></aside></div>{source&&<div class="wrap"><SourceDetails page={source}/></div>}</section>}

{!['/donate/','/join-us/','/activity-groups/','/what-we-do/','/get-support/','/our-story/','/get-in-touch/','/resources/','/disclaimer/'].includes(route)&&!isEvents&&!isNews&&!isReferral&&page.kind!=='event'&&<section class="section"><div class="wrap content-grid"><article class="prose">
{route.startsWith('/spaces/')&&<div class="notice"><p>Visits are by appointment. Published location references need reconciliation; please contact the team to confirm the address before travelling.</p></div>}
{page.kind==='policy'&&<p class="source-note">Original published policy wording, captured 8 October 2026. The redesigned preview does not introduce tracking or a consent form.</p>}
{page.images.filter((i:string)=>!i.toLowerCase().includes('partner')).slice(0,1).map((image:string)=><figure class="reader-photo"><Photo name={image} alt={'Original photograph or illustration from '+friendlyTitle}/></figure>)}
<SourceText paragraphs={page.paragraphs}/>
<p class="source-note">Published content captured 8 October 2026. <a href={page.url}>View the original page ↗</a></p>
</article><aside class="side-panel"><h2>Explore the foundation</h2><a href={url('/get-support/')}>Get support ↗</a><a href={url('/what-we-do/')}>Our work ↗</a><a href={url('/what-we-do/healthy-relationship-education/')}>Healthy relationship education ↗</a><a href={url('/what-we-do/fyp-for-you-project/')}>For You Project ↗</a><a href={url('/lgbtq/')}>LGBTQ+ support ↗</a><a href={url('/activity-groups/')}>Community activities ↗</a><a href={url('/resources/')}>Documents & resources ↗</a>{sourceRelated.length>0&&<><h2 style="margin-top:40px">Related information</h2>{sourceRelated.map(l=><a href={url(l.href)}>{l.label} ↗</a>)}</>}</aside></div></section>}
</Layout>
<script>
const search=document.querySelector<HTMLInputElement>('[data-archive-search]');
const items=Array.from(document.querySelectorAll<HTMLElement>('[data-search-text]'));
const status=document.querySelector<HTMLElement>('[data-search-status]');
const empty=document.querySelector<HTMLElement>('[data-no-results]');
search?.addEventListener('input',()=>{const query=search.value.trim().toLowerCase();let count=0;items.forEach(item=>{const match=(item.dataset.searchText||'').includes(query);item.hidden=!match;if(match)count++;});if(status)status.textContent=`${count} ${count===1?'event':'events'}${query?' matching your search':' in the archive'}`;if(empty)empty.hidden=count>0;});
</script>
